# Server
NODE_ENV=development
PORT=8000

# Required for persistence in production (MongoDB Atlas free tier works well)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/sorabox?retryWrites=true&w=majority
MONGODB_DB=sorabox

# Required to mirror every published poster to ImgBB. Keep this a Koyeb secret;
# never put the value in source code or a client-side VITE_ variable.
IMGBB_API_KEY=replace_with_your_imgbb_server_key

# Optional but recommended: automatic title, synopsis, year and poster matching.
# Create a TMDB API key or read-access token at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Telegram delivery bot
TELEGRAM_BOT_TOKEN=123456:replace_with_botfather_token
TELEGRAM_BOT_USERNAME=YourCatalogBot
# Private database channel ID. Add the bot as an administrator before uploading.
TELEGRAM_STORAGE_CHANNEL_ID=-1001234567890
# Comma-separated numeric Telegram user IDs allowed to publish content.
TELEGRAM_ADMIN_IDS=123456789
# Use exactly one running bot instance with long polling (ideal for one Koyeb service).
TELEGRAM_MODE=polling
