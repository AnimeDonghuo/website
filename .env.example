# Server
NODE_ENV=development
PORT=8000
# Public canonical address for Telegram announcement buttons. On Koyeb, use
# your service domain, e.g. https://your-catalog.koyeb.app (no trailing slash).
PUBLIC_SITE_URL=https://your-catalog.koyeb.app

# Required for persistence in production (MongoDB Atlas free tier works well)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/sorabox?retryWrites=true&w=majority
MONGODB_DB=sorabox

# Required to mirror every published poster to ImgBB. Keep this a Koyeb secret;
# never put the value in source code or a client-side VITE_ variable.
IMGBB_API_KEY=replace_with_your_imgbb_server_key

# Optional but recommended: automatic title, synopsis, year and poster matching.
# Create a TMDB API key or read-access token at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
# OMDb is used as a movie/series fallback when TMDB has no confident match.
OMDB_API_KEY=
# AniList is a public GraphQL fallback for Anime and Donghua; no key is needed.

# Telegram delivery bot
TELEGRAM_BOT_TOKEN=123456:replace_with_botfather_token
# This is checked against the username returned by TELEGRAM_BOT_TOKEN at startup;
# the active token automatically becomes the source of public delivery links.
TELEGRAM_BOT_USERNAME=YourCatalogBot
# Private database channel ID. Add the bot as an administrator before uploading.
# /batch accepts only t.me/c ranges from this exact channel; /auto persistently
# groups matching newly posted media here before creating one combined catalog post.
TELEGRAM_STORAGE_CHANNEL_ID=-1001234567890
# Optional: where /request messages are sent. Defaults to TELEGRAM_STORAGE_CHANNEL_ID.
TELEGRAM_REQUEST_CHANNEL_ID=-1001234567890
# Optional comma-separated numeric Telegram IDs. If set, only these IDs can use /login.
TELEGRAM_ADMIN_IDS=123456789
# Keep this a Koyeb secret. Set it to the passcode you want (for example: AYU).
ADMIN_LOGIN_CODE=choose_a_private_publisher_passcode
# Successful /login sessions expire after this many hours (1-168).
ADMIN_SESSION_HOURS=24
# Use exactly one running bot instance with long polling (ideal for one Koyeb service).
TELEGRAM_MODE=polling
